# Caddy handles TLS automatically: it obtains and renews Let's Encrypt
# certificates with no cron job, no certbot, no manual renewal. On a Hetzner
# box this removes an entire category of 3am outage ("the cert expired").
#
# Requirements: DNS A/AAAA record for {$DOMAIN} pointing at this server, and
# ports 80 and 443 open in the Hetzner Cloud firewall.

{$DOMAIN} {

	encode gzip zstd

	# ── Security headers ────────────────────────────────────────────────────
	header {
		# HSTS: after the first visit, browsers refuse to talk to this host
		# over plain HTTP for a year. preload submits to the browser-baked
		# list so even the *first* visit is protected.
		# Do not enable preload until you are certain every subdomain is
		# HTTPS-only — it is very hard to undo.
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

		# Stop the browser guessing content types. Prevents a user-uploaded
		# file being sniffed as executable HTML/JS.
		X-Content-Type-Options "nosniff"

		# Legacy clickjacking defence. CSP frame-ancestors below supersedes it
		# for modern browsers; keep both.
		X-Frame-Options "DENY"

		Referrer-Policy "strict-origin-when-cross-origin"

		# Turn off browser features we never use. If an XSS does land, it
		# cannot reach the camera or geolocation.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"

		# Content-Security-Policy is the single most effective anti-XSS control.
		# 'self' only — no inline scripts, no eval.
		# Stripe needs js.stripe.com and its iframe; that is why payment=(self)
		# above and frame-src below are scoped rather than blanket-denied.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://js.stripe.com; style-src 'self'; img-src 'self' data: https:; connect-src 'self' https://api.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

		# Do not advertise what we are running.
		-Server
		-X-Powered-By
	}

	# ── API ─────────────────────────────────────────────────────────────────
	handle /api/* {
		reverse_proxy backend:8080 {
			# Pass the true client IP through. Without these, every request
			# appears to come from Caddy's container IP, which silently breaks
			# rate limiting (one shared bucket for the whole internet) and
			# writes a useless IP into the audit log.
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Actuator is never exposed publicly. Health checks run inside the Docker
	# network; there is no reason for the internet to reach it.
	handle /actuator/* {
		respond 404
	}

	# Product images (uploaded + bundled placeholders) are served by the
	# backend (CatalogController / ProductImageController), not shipped in
	# the frontend's static build — without this, these requests fall
	# through to the SPA catch-all below and get index.html back instead of
	# an image, which silently breaks every product thumbnail.
	handle /product-images/* {
		reverse_proxy backend:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# robots.txt and sitemap.xml are GENERATED by the backend
	# (SitemapController) because the sitemap lists live catalogue URLs.
	# They need their own route: without it they fall through to the SPA
	# catch-all below and Caddy serves index.html with a 200 status, so
	# the failure is invisible unless you check the content-type.
	handle /robots.txt {
		reverse_proxy backend:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle /sitemap.xml {
		reverse_proxy backend:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# ── Public pages ────────────────────────────────────────────────────────
	# Rendered by the backend (SeoPageController): the built app with this page's
	# own title, description, canonical URL, structured data and readable content
	# already in the HTML, for crawlers and link previews that never run
	# JavaScript. Browsers get the same app; React replaces the pre-filled content.
	#
	# If the backend cannot fill the page in (503) or cannot be reached at all
	# (502/504, handled below), the plain static app is served instead, so a
	# backend problem never blanks the front page.
	@publicPages path / /products /products/* /about /contacts /privacy /sales-conditions
	handle @publicPages {
		reverse_proxy backend:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}

			@cannotRender status 503
			handle_response @cannotRender {
				root * /srv/frontend
				rewrite * /index.html
				file_server
			}
		}
	}

	handle_errors {
		@publicPage path / /products /products/* /about /contacts /privacy /sales-conditions
		handle @publicPage {
			root * /srv/frontend
			rewrite * /index.html
			file_server
		}

		# The 404 keeps its status: Caddy serves the file but leaves the error code.
		@notFound expression {err.status_code} == 404
		handle @notFound {
			rewrite * /404.html
			file_server
		}
	}

	# ── Frontend ────────────────────────────────────────────────────────────
	# Order matters. Real static files (JS, CSS, fonts, icons) are served first.
	# Known client routes get the app shell with 200. Anything else is a real
	# 404: the shell is served again from 404.html (a copy of index.html made by
	# the frontend build), so NotFoundPage still renders, but crawlers and link
	# checkers see that the URL does not exist. Keep the route list below in step
	# with frontend/src/App.tsx.
	root * /srv/frontend

	@staticFile file
	handle @staticFile {
		file_server
	}

	@spaRoute path / /products /products/* /privacy /sales-conditions /contacts /about /login /register /oauth/google/callback /verify-email /forgot-password /reset-password /account /cart /checkout /orders /orders/* /admin /admin/*
	handle @spaRoute {
		rewrite * /index.html
		file_server
	}

	handle {
		error 404
	}

	log {
		output file /var/log/caddy/access.log
		format json
	}
}
