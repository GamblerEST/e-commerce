# Local development only. Uses Caddy's internal CA to mint a self-signed
# certificate for https://localhost — real TLS for a local docker compose
# run, without needing a real domain, port 80/443 open to the internet, or
# Let's Encrypt, which only the real deployment uses. The browser (and curl without -k) will flag the cert as
# untrusted — that is expected, and specific to local dev.
#
# The PRODUCTION Caddyfile is ./Caddyfile, used only when deploying with
# `docker compose -f docker-compose.yml up -d` (which ignores this file and
# docker-compose.override.yml entirely — see that file's header comment).

localhost {
	tls internal

	encode gzip zstd

	handle /api/* {
		reverse_proxy backend:8080 {
			# Same reasoning as the production Caddyfile: without these the
			# backend sees every request as coming from Caddy's container IP,
			# which breaks rate limiting and audit logging.
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Actuator is never exposed publicly, even locally — same posture as prod.
	handle /actuator/* {
		respond 404
	}

	# Same reasoning as the production Caddyfile: without this, product image
	# requests fall through to the SPA catch-all below and get index.html
	# back instead of an image.
	handle /product-images/* {
		reverse_proxy backend:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# robots.txt and sitemap.xml are GENERATED by the backend
	# (SitemapController) because the sitemap lists live catalogue URLs.
	# They need their own route: without it they fall through to the SPA
	# catch-all below and Caddy serves index.html with a 200 status, so
	# the failure is invisible unless you check the content-type.
	handle /robots.txt {
		reverse_proxy backend:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle /sitemap.xml {
		reverse_proxy backend:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# ── Public pages ────────────────────────────────────────────────────────
	# Rendered by the backend (SeoPageController): the built app with this page's
	# own title, description, canonical URL, structured data and readable content
	# already in the HTML, for crawlers and link previews that never run
	# JavaScript. Browsers get the same app; React replaces the pre-filled content.
	#
	# If the backend cannot fill the page in (503) or cannot be reached at all
	# (502/504, handled below), the plain static app is served instead, so a
	# backend problem never blanks the front page.
	@publicPages path / /products /products/* /about /contacts /privacy /sales-conditions
	handle @publicPages {
		reverse_proxy backend:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}

			@cannotRender status 503
			handle_response @cannotRender {
				root * /srv/frontend
				rewrite * /index.html
				file_server
			}
		}
	}

	handle_errors {
		@publicPage path / /products /products/* /about /contacts /privacy /sales-conditions
		handle @publicPage {
			root * /srv/frontend
			rewrite * /index.html
			file_server
		}

		# The 404 keeps its status: Caddy serves the file but leaves the error code.
		@notFound expression {err.status_code} == 404
		handle @notFound {
			rewrite * /404.html
			file_server
		}
	}

	# ── Frontend ────────────────────────────────────────────────────────────
	# Order matters. Real static files (JS, CSS, fonts, icons) are served first.
	# Known client routes get the app shell with 200. Anything else is a real
	# 404: the shell is served again from 404.html (a copy of index.html made by
	# the frontend build), so NotFoundPage still renders, but crawlers and link
	# checkers see that the URL does not exist. Keep the route list below in step
	# with frontend/src/App.tsx.
	root * /srv/frontend

	@staticFile file
	handle @staticFile {
		file_server
	}

	@spaRoute path / /products /products/* /privacy /sales-conditions /contacts /about /login /register /oauth/google/callback /verify-email /forgot-password /reset-password /account /cart /checkout /orders /orders/* /admin /admin/*
	handle @spaRoute {
		rewrite * /index.html
		file_server
	}

	handle {
		error 404
	}
}
