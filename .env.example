# Copy to .env. Non-secret config only — real secrets live in deploy/secrets/
# (generated by ./deploy/init-secrets.sh) and are mounted as Docker secrets.
#
# The defaults below are for LOCAL review/dev — copy and run, no edits needed.
# For a real deploy, set DOMAIN/JWT_ISSUER/CORS_ORIGINS/FRONTEND_URL to the
# real domain, fill in the mail + Google values, and COMMENT OUT the
# CADDY_*_PORT lines so Caddy binds the real 80/443 (required for Let's Encrypt).

DOMAIN=localhost
JWT_ISSUER=https://shop.ee
CORS_ORIGINS=http://localhost:5173
# Used to build the Google OAuth redirect_uri — MUST match a URI registered
# in Google Cloud Console exactly (scheme + host + /oauth/google/callback).
FRONTEND_URL=http://localhost:5173

# Free path (recommended, no paid SMTP provider needed): a Gmail account's
# own SMTP relay with an App Password — myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled first). The App Password goes in
# deploy/secrets/mail_password, NEVER your actual Google account password —
# that's a scoped, revocable credential; your login password is neither.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-address@gmail.com

GOOGLE_CLIENT_ID=

# Estonian bank-link payments through Montonio, off by default. To try Montonio's
# sandbox: MONTONIO_ENABLED=true, MONTONIO_API_URL=https://sandbox-stargate.montonio.com/api,
# the sandbox access key below, and the sandbox secret key in
# deploy/secrets/montonio_secret_key. Both keys come from the Montonio Partner System.
# There is deliberately no default URL, so production never falls back to the sandbox.
MONTONIO_ENABLED=false
MONTONIO_API_URL=
MONTONIO_ACCESS_KEY=

# Hetzner Storage Box for off-site backups (unused locally)
BACKUP_REMOTE=

# Local: unprivileged ports for Caddy's self-signed-TLS listener, so it never
# collides with anything already on 80/443. See deploy/Caddyfile.local.
CADDY_HTTP_PORT=8088
CADDY_HTTPS_PORT=8443

# HikariCP connection-pool size. The default of 10 is the throughput ceiling
# identified in PERFORMANCE.md; roughly 4x the host's core count is a sensible
# starting point if you raise it. More is not better — a pool larger than the
# database can service moves the queue rather than removing it.
DB_POOL_MAX=10
