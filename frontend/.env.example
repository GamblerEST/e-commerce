# Copy to .env (gitignored — matches the root .env pattern).
#
# This is the reCAPTCHA SITE key, not the secret key. It is meant to be
# public — it ships in the JS bundle and is visible to anyone viewing the
# page source. The SECRET key never goes here; it lives server-side only,
# in deploy/secrets/recaptcha_secret.
#
# Leave blank for local dev without Google keys: RegisterPage skips
# rendering the widget entirely and the backend's RecaptchaService accepts
# registration unchecked (see README "Known limitations").
VITE_RECAPTCHA_SITE_KEY=

# Stripe publishable key (pk_test_... / pk_live_...) — public by design, same
# reasoning as the reCAPTCHA site key above. The SECRET key never goes here;
# it lives server-side only, in deploy/secrets/stripe_secret_key.
VITE_STRIPE_PUBLISHABLE_KEY=
