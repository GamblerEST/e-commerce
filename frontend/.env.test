# Loaded automatically for `vitest run` (Vite sets MODE=test), overriding
# whatever happens to be in the developer's local .env — tests must never
# depend on which real credentials someone happens to have configured
# locally. Empty on purpose: exercises the same "not configured" path the
# backend degrades to without a real secret.
VITE_RECAPTCHA_SITE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
